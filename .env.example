# Root — copy to .env for local infra (never commit .env)
POSTGRES_USER=noto
POSTGRES_PASSWORD=noto_dev_password_change_me
POSTGRES_DB=noto
POSTGRES_PORT=5433
DATABASE_URL=postgres://noto:noto_dev_password_change_me@localhost:5433/noto

# API (see apps/api/.env.example for full list)
API_PORT=3000
JWT_ACCESS_SECRET=change_me_access_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_min_32_chars

# Mobile (see apps/mobile/.env.example)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
